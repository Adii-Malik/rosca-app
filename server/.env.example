# ---- Database ----
# MongoDB Atlas for production, or a local instance for development:
#   mongodb://127.0.0.1:27017/rosca
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
ATLAS_CONNECTION=

# ---- Server ----
# Must match internal_port in fly.toml when deploying (8080).
PORT=5001

# Comma-separated browser origins allowed to call the API.
# Leave blank to allow any origin (development only).
CORS_ORIGIN=http://localhost:3000

# ---- Authentication ----
ADMIN_USER=admin

# Development only. For production generate a hash instead:
#   npm run hash-password 'your-password'
ADMIN_PASSWORD=password123

# Production: the bcrypt hash from the command above. Takes precedence over
# ADMIN_PASSWORD when set.
# ADMIN_PASSWORD_HASH=

# Signing key for session tokens. Required in production — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---- Draw ----
# How long the wheel spins before the winner is revealed (ms). The client then
# decelerates onto them over a further 2.4s.
DRAW_ANIMATION_MS=7000

# How far past its scheduled moment the server will still start a draw by
# itself (ms). Covers a restart; beyond it, an admin runs the round by hand so a
# late draw does not start with nobody watching.
DRAW_AUTO_GRACE_MS=3600000

# How often the scheduler checks for due draws (ms). Rarely needs changing.
SCHEDULER_TICK_MS=60000

# Blocks every write — HTTP mutations, scheduled draws and manual draws — while
# still allowing sign-in and all reads. Use when pointing the app at a real
# database to look around.
# READ_ONLY=true
